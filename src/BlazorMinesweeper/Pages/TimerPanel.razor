@implements IDisposable

<div class="timerPanel" title="Tempo decorrido">
    <img class="points" src="images/ClockLabel.png" />
    <img src="images/Counter@(minutesDigit1).png" />
    <img src="images/Counter@(minutesDigit2).png" />
    @if(pointsFlag)
    {
        <img class="points" src="images/PointsLight.png" />
    }
    else
    {
        <img class="points" src="images/PointsDark.png" />
    }
    <img src="images/Counter@(secondsDigit1).png" />
    <img src="images/Counter@(secondsDigit2).png" />
</div>

@code {
    [Parameter, EditorRequired]
    public TimerModel TimerModel { get; set; } = default!;

    private int secondsDigit1;
    private int secondsDigit2;
    private int minutesDigit1;
    private int minutesDigit2;
    private bool pointsFlag = true;

    override protected void OnParametersSet()
    {
        TimerModel.OnTick += OnTick;
    }

    private void OnTick()
    {
        var elapsedTime = TimerModel.ElapsedTime;
        secondsDigit1 = elapsedTime.Seconds / 10;
        secondsDigit2 = elapsedTime.Seconds % 10;
        minutesDigit1 = elapsedTime.Minutes / 10;
        minutesDigit2 = elapsedTime.Minutes % 10;
        pointsFlag = !TimerModel.IsRunning || elapsedTime.Milliseconds < 500;
        StateHasChanged();
    }

    public void Dispose()
    {
        TimerModel.OnTick -= OnTick;
    }
}
