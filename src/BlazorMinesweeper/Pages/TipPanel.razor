@using BlazorMinesweeper.Models
@implements IDisposable

@if (Board.State != GameState.Started)
{
    return;
}

<button @onclick="ButtonClicked" title="Dica">
    <img src="images/Tip.png" />
</button>

@if (showError)
{
    <div>Dica indisponível</div>
}

@code {
    [Parameter, EditorRequired]
    public Board Board { get; set; } = default!;

    private bool showError = false;

    override protected void OnParametersSet()
    {
        Board.OnBoardChange += BoardStateChanged;
    }

    public void Dispose()
    {
        Board.OnBoardChange -= BoardStateChanged;
    }

    private void BoardStateChanged()
    {
        showError = false;
        StateHasChanged();
    }

    private void ButtonClicked(MouseEventArgs args)
    {
        showError = !Board.TryCreateTip();
    }
}
