@implements IDisposable

@if (GameModel.State != GameState.Started)
{
    return;
}

<button @onclick="ButtonClicked" title="Dica">
    <img src="images/Tip.png" />
</button>

@if (showError)
{
    <div>Dica indisponível</div>
}

@code {
    [Parameter, EditorRequired]
    public GameModel GameModel { get; set; } = default!;

    private bool showError = false;

    override protected void OnParametersSet()
    {
        GameModel.OnBoardChange += BoardStateChanged;
    }

    public void Dispose()
    {
        GameModel.OnBoardChange -= BoardStateChanged;
    }

    private void BoardStateChanged()
    {
        showError = false;
        StateHasChanged();
    }

    private void ButtonClicked(MouseEventArgs args)
    {
        showError = !GameModel.TryCreateTip();
    }
}
