@using BlazorMinesweeper.Models
@implements IDisposable
@inject Blazored.LocalStorage.ILocalStorageService LocalStorage

<ImagePreloader />

<h3>MineField</h3>

@if (showOptions)
{
    <SettingsPanel GameSettings="@GameSettings" OnClose="@OnCloseSettings" />
    return;
}

<table class="mainTable" cellspacing="0" cellpadding="0">
    <tbody>
        <tr>
            <td>
                <div class="headerPanel">
                    <table cellspacing="0" cellpadding="0" style="width:100%">
                        <tr>
                            <td>
                                <FlagDisplay Board="@Board" />
                            </td>
                            <td>
                                <ResetPanel Board="@Board" OnClick="ResetClicked" />
                            </td>
                            <td>
                                <TimerPanel BoardTimer="@Board.Timer" />
                            </td>
                        </tr>
                    </table>
                </div>
            </td>
        </tr>
        <tr>
           <td>
                <MineField Board="@Board" />
            </td>
        </tr>
        <tr>
            <td>
                <div class="footerPanel">
                    <table cellspacing="0" cellpadding="0" style="width:100%">
                        <tr>
                            @if (GameSettings.AllowTips)
                            {
                                <td>
                                    <TipPanel Board="@Board" />
                                </td>
                            }
                            <td style="text-align:right;">
                                <button @onclick="() => showOptions = true" title="Opções">
                                    <img src="images/Options.png" />
                                </button>
                            </td>
                        </tr>
                    </table>
                </div>
            </td>
        </tr>
    </tbody>
</table>

@code {
    public Board Board { get; set; } = default!;
    public GameSettings GameSettings { get; set; } = default!;

    private const string LocalStorageKey = "GameSettings";
    private bool showOptions = false;

    protected override async Task OnInitializedAsync()
    {
        var savedSettings = await LocalStorage.GetItemAsync<GameSettings>(LocalStorageKey);

        if (savedSettings is not null && BoardSetup.IsValid(savedSettings.BoardSetup))
            GameSettings = savedSettings;
        else
            GameSettings = new();

        Board = new Board(GameSettings.BoardSetup, GameSettings.PreventImediateWin);
    }

    public void Dispose() 
    {
        Board?.Dispose();
    }

    public void OnCloseSettings(bool isModified)
    {
        showOptions = false;
        if (!isModified)
            return;

        Board.Reset(GameSettings.BoardSetup, GameSettings.PreventImediateWin);
        LocalStorage.SetItemAsync(LocalStorageKey, GameSettings);
        StateHasChanged();
    }

    private void ResetClicked()
    {
        Board.Reset();
        StateHasChanged();
    }

    private void TipClicked(MouseEventArgs args)
    {
        var square = Board.TryCreateTip();

    }
}