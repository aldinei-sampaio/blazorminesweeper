@page "/"

<h1>Campo Minado em Blazor</h1>
<p>Versão 1.0</p>

@if (!imagesLoaded)
{
    <ImagePreloader Loaded="ImagesLoaded" />
}
else
{
    <GamePanel />
}

@code {
    private bool imagesLoaded = false;

    private void ImagesLoaded()
    {
        imagesLoaded = true;
        StateHasChanged();
    }
}
