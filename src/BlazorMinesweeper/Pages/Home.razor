@page "/"

<h1>Campo Minado em Blazor</h1>
<p>Versão @GetVersion()</p>

<ImagePreloader Loaded="ImagesLoaded" />

@if (imagesLoaded)
{
    <GamePanel />
}

@code {
    private bool imagesLoaded = false;

    private void ImagesLoaded()
    {
        imagesLoaded = true;
        StateHasChanged();
    }

    private string GetVersion() => System.Reflection.Assembly.GetExecutingAssembly().GetName().Version?.ToString() ?? "1.0.0";
}
