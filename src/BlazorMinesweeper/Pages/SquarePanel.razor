@implements IDisposable

@(SquareModel.DisplayMode switch
{
    SquareDisplayMode.Normal =>
        @<div class="square square-closed">
            <div id="square-button"
                 class="square-button @GetTipClass()"
                 @onmouseup:stopPropagation="true"
                 @onmouseup:preventDefault="true"
                 @onmouseup="OnClosedMouseUp">
            </div>
        </div>,

    SquareDisplayMode.Flag =>
        @<div class="square square-closed">
            <div id="square-button"
                 class="square-button"
                 @onmouseup:stopPropagation="true"
                 @onmouseup:preventDefault="true"
                 @onmouseup="OnClosedMouseUp">
                <img src="images/Flag.png" />
            </div>
        </div>,

    SquareDisplayMode.Unknown =>
        @<div class="square square-closed">
            <div id="square-button"
                 class="square-button"
                 @onmouseup:stopPropagation="true"
                 @onmouseup:preventDefault="true"
                 @onmouseup="OnClosedMouseUp">
                <img src="images/Unknown.png" />
            </div>
        </div>,

    SquareDisplayMode.Empty => 
        @<div class="square square-open"></div>,

    SquareDisplayMode.Exploded => 
        @<div class="square square-exploded">
            <img src="images/Mine.png" />
        </div>,

    SquareDisplayMode.Mine => 
        @<div class="square square-open">
            <img src="images/Mine.png" />
        </div>,

    SquareDisplayMode.NumberActive =>
        @<div class="square square-open"
              @onmouseup:stopPropagation="true"
              @onmouseup:preventDefault="true"
              @onmouseup="OnOpenMouseUp"
              @onmousedown:stopPropagation="true"
              @onmousedown:preventDefault="true"
              @onmousedown="OnOpenMouseDown">
            <img src="images/@(SquareModel.DisplayNumber).png" />
        </div>,

    SquareDisplayMode.NumberInactive =>
        @<div class="square square-open">
            <img src="images/@(SquareModel.DisplayNumber)a.png" />
        </div>,

    SquareDisplayMode.RightFlag =>
        @<div class="square square-open">
            <img src="images/Flag.png" />
        </div>,

    SquareDisplayMode.WrongFlag =>
        @<div class="square square-open">
            <img src="images/WrongFlag.png" />
        </div>,

    _ => @<div class="square square-open"></div>
})

@code {
    [Parameter, EditorRequired]
    public GameModel GameModel { get; set; } = default!;

    [Parameter, EditorRequired]
    public SquareModel SquareModel { get; set; } = default!;

    private bool leftPressed = false;
    private bool rightPressed = false;

    protected override void OnParametersSet()
    {
        SquareModel.OnUpdate += StateHasChanged;
    }

    private string GetTipClass()
    {
        return SquareModel.TipType switch
        {
            TipType.Mine => "tip-mine",
            TipType.Safe => "tip-safe",
            _ => string.Empty
        };
    }

    private void OnOpenMouseUp(MouseEventArgs args)
    {
        if (leftPressed && rightPressed)
            GameModel.OpenNeighborhood(SquareModel);

        leftPressed = false;
        rightPressed = false;
    }

    private void OnOpenMouseDown(MouseEventArgs args)
    {
        if (args.Button == 0)
            leftPressed = true;
        else if (args.Button == 2)
            rightPressed = true;
    }

    public void Dispose()
    { 
        SquareModel.OnUpdate -= StateHasChanged;
    }

    private void OnClosedMouseUp(MouseEventArgs args)
    {
        if (args.Button == 0)
        {
            if (SquareModel.DisplayMode == SquareDisplayMode.Normal)
                GameModel.Open(SquareModel);

            return;
        }

        if (args.Button == 2)
            GameModel.ToggleState(SquareModel);
    }
}
