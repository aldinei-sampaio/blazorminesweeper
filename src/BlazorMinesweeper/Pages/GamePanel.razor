@implements IDisposable
@inject Blazored.LocalStorage.ILocalStorageService LocalStorage

@if (GameSettings is null)
{
    return;
}

@if (showOptions)
{
    <SettingsPanel GameSettings="@GameSettings" OnClose="@OnCloseSettings" />
    return;
}

<table class="mainTable" cellspacing="0" cellpadding="0">
    <tbody>
        <tr>
            <td>
                <div class="headerPanel">
                    <table cellspacing="0" cellpadding="0" class="w-100">
                        <tr>
                            <td class="text-left">
                                <FlagDisplayPanel GameModel="@GameModel" />
                            </td>
                            <td>
                                <ResetPanel GameModel="@GameModel" OnClick="ResetClicked" />
                            </td>
                            <td class="text-right">
                                <TimerPanel TimerModel="@GameModel.Timer" />
                            </td>
                        </tr>
                    </table>
                </div>
            </td>
        </tr>
        <tr>
            <td>
                <BoardPanel GameModel="@GameModel" />
            </td>
        </tr>
        <tr>
            <td>
                <div class="footerPanel">
                    <table cellspacing="0" cellpadding="0" class="w-100">
                        <tr>
                            @if (GameSettings.AllowTips)
                            {
                                <td class="text-left">
                                    <TipPanel GameModel="@GameModel" />
                                </td>
                            }
                            <td class="text-right">
                                <button @onclick="() => showOptions = true" title="Opções">
                                    <img src="images/Options.png" />
                                </button>
                            </td>
                        </tr>
                    </table>
                </div>
            </td>
        </tr>
    </tbody>
</table>


@code {
    public GameModel GameModel { get; set; } = default!;
    public GameSettings GameSettings { get; set; } = default!;

    private const string LocalStorageKey = "GameSettings";
    private bool showOptions = false;

    protected override async Task OnInitializedAsync()
    {
        var savedSettings = await LocalStorage.GetItemAsync<GameSettings>(LocalStorageKey);

        if (savedSettings is not null && BoardSetup.IsValid(savedSettings.BoardSetup))
            GameSettings = savedSettings;
        else
            GameSettings = new();

        GameModel = new GameModel(GameSettings.BoardSetup, GameSettings.PreventImediateWin);
    }

    public void Dispose()
    {
        GameModel?.Dispose();
    }

    public void OnCloseSettings(bool isModified)
    {
        showOptions = false;
        StateHasChanged();
        if (!isModified)
            return;

        GameModel.Reset(GameSettings.BoardSetup, GameSettings.PreventImediateWin);
        LocalStorage.SetItemAsync(LocalStorageKey, GameSettings);
    }

    private void ResetClicked()
    {
        GameModel.Reset();
        StateHasChanged();
    }
}