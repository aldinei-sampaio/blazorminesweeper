@using BlazorMinesweeper.Models

<table class="mineField" cellspacing="0" cellpadding="0">
    <tbody>
        @for (var row = Board.MinRow; row <= Board.MaxRow; row++)
        {
            <tr>
                @for (var column = Board.MinColumn; column < Board.MaxColumn; column++)
                {
                    <td class="fieldCell">
                        <SquarePanel Board="@Board" Square="@Board[row, column]" />
                    </td>
                }
            </tr>
        }
    </tbody>
</table>

@code {
    [Parameter, EditorRequired]
    public Board Board { get; set; } = default!;
}
