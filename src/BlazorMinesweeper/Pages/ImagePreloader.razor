@using Microsoft.AspNetCore.Components

<div class="image-preloader">
    @if (!isLoaded)
    {
        <div class="progress-wrapper">
            <div class="progress">
                <div class="progress-fill" style="width:@ProgressPercent%"></div>
            </div>
            <div class="progress-text">Loading images: @loadedCount / @totalCount (@ProgressPercent%)</div>
        </div>
    }

    @foreach (var src in ImageSources)
    {
        <img class="preload-img" src="@src"
             @onload="@(()=>OnImageFinished(src, true))"
             @onerror="@(()=>OnImageFinished(src, false))" />
    }
</div>

@code {
    [Parameter]
    public EventCallback Loaded { get; set; }

    // List of images to preload
    private readonly string[] ImageSources = new[]
    {
        "images/1.png",
        "images/2.png",
        "images/3.png",
        "images/4.png",
        "images/5.png",
        "images/6.png",
        "images/7.png",
        "images/8.png",
        "images/1a.png",
        "images/2a.png",
        "images/3a.png",
        "images/4a.png",
        "images/5a.png",
        "images/6a.png",
        "images/7a.png",
        "images/8a.png",
        "images/Mine.png",
        "images/Flag.png",
        "images/Unknown.png",
        "images/WrongFlag.png",
        "images/Counter.png",
        "images/Counter0.png",
        "images/Counter1.png",
        "images/Counter2.png",
        "images/Counter3.png",
        "images/Counter4.png",
        "images/Counter5.png",
        "images/Counter6.png",
        "images/Counter7.png",
        "images/Counter8.png",
        "images/Counter9.png",
        "images/Ready.png",
        "images/Started.png",
        "images/Won.png",
        "images/Lost.png",
        "images/MineLabel.png",
        "images/ClockLabel.png",
        "images/Tip.png",
        "images/Options.png",
        "images/NormalButtonReady.png",
        "images/NormalButtonHover.png",
        "images/NormalButtonPressed.png",
        "images/NormalButtonDisabled.png",
        "images/TipButtonReady.png",
        "images/TipButtonHover.png",
        "images/TipButtonPressed.png",
        "images/TipButtonDisabled.png",
        "images/TipGreen.png",
        "images/TipRedButtonReady.png",
        "images/TipRedButtonHover.png",
        "images/TipRedButtonPressed.png",
        "images/TipRedButtonDisabled.png",
        "images/TipRed.png",
        "images/PointsLight.png",
        "images/PointsDark.png",
        "images/AutoPlay.png",
    };

    private int loadedCount = 0;
    private int totalCount => ImageSources.Length;
    private bool isLoaded = false;

    private int ProgressPercent => totalCount == 0 ? 100 : (int)((loadedCount * 100.0) / totalCount);

    private void OnImageFinished(string src, bool success)
    {
        // Count both success and error as finished so the preloader doesn't hang on missing resources
        loadedCount++;
        if (!isLoaded && loadedCount >= totalCount)
        {
            isLoaded = true;
            _ = Loaded.InvokeAsync(null);
        }

        // Update UI
        StateHasChanged();
    }
}
