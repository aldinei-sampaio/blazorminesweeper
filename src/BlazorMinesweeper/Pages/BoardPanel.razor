<table class="fieldTable" cellspacing="0" cellpadding="0" style="--cols:@GameModel.Columns">
    <tbody>
        @for (var row = GameModel.MinRow; row <= GameModel.MaxRow; row++)
        {
            <tr>
                @for (var column = GameModel.MinColumn; column <= GameModel.MaxColumn; column++)
                {
                    <td class="fieldCell">
                        <div class="square">
                            <SquarePanel GameModel="@GameModel" SquareModel="@GameModel[row, column]" />
                        </div>
                    </td>
                }
            </tr>
        }
    </tbody>
</table>

@code {
    [Parameter, EditorRequired]
    public GameModel GameModel { get; set; } = default!;
}
