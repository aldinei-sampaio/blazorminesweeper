@implements IDisposable

<div class="resetPanel">
    <button @onclick="() => OnClick?.Invoke()" title="Reiniciar jogo">
        @(GameModel.State switch
        {
            GameState.Ready => @<img src="images/Ready.png" />,
            GameState.Started => @<img src="images/Started.png" />,
            GameState.Won => @<img src="images/Won.png" />,
            GameState.Lost => @<img src="images/Lost.png" />,
            _ => @<img src= "images/Ready.png" />
        })
    </button>
</div>

@code {
    [Parameter, EditorRequired]
    public GameModel GameModel { get; set; } = default!;

    [Parameter, EditorRequired]
    public Action? OnClick { get; set; } = default!;

    override protected void OnParametersSet()
    {
        GameModel.OnStateChange += StateHasChanged;
    }

    public void Dispose()
    {
        GameModel.OnStateChange -= StateHasChanged;
    }
}
